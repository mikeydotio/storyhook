$ story no-such-verb --json
exit: 2
stdout: 
{"error":"unknown command `no-such-verb`. Run `story --help` for usage.","exit_code":2,"result":"error"}

stderr: <empty>

$ story list --no-such-flag --json
exit: 2
stdout: 
{"error":"unknown flag `--no-such-flag` for `story list`.\n\n`story list` takes: --state --assignee --priority --label --created-after --updated-after --stale --phase --type --flagged --blocked --ready --drafts --unassessed --include-closed --include-archived --all\nIf `--no-such-flag` was meant as text rather than a flag, quote it as one argument, or put it after a `--`.","exit_code":2,"result":"error"}

stderr: <empty>

