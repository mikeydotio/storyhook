#!/usr/bin/env bash
#
# The push gate — SH-306, narrowed by SH-429.
#
# Git runs this hook itself, synchronously, with no timeout and no interest in
# whether the push was typed, scripted, backgrounded or issued by an agent —
# which is the whole reason the gate lives here rather than in a Claude Code
# `PreToolUse` hook (SH-306's original: a 900-second ceiling after which the
# push proceeded ungated and unannounced, six of eight logs on that machine
# ending at exactly 900s over three days).
#
# WHAT CHANGED (SH-429). This hook used to REFUSE any push whose tree carried
# no `gate-receipt.sh` receipt, for every ref. But since SH-396, that refusal
# was already certifying a fact that does not decide what reaches `main`:
# `gh pr merge --merge` is a server-side merge that never triggers a local
# push hook at all, and a merge tree is a two-parent combination this hook has
# never even seen — `scripts/merge-preflight.sh` (run by `scripts/merge-
# watch.sh`) is what actually gates a merge, unconditionally, regardless of
# what any push carried. So making an ordinary feature-branch push wait on a
# multi-minute suite was gating content that was never, on its own, the thing
# landing — while doing nothing to make the merge itself safer.
#
# This hook now REPORTS on every non-`main`/`master` ref (which tier's receipt
# it found, or that it found none — never refuses) and REFUSES ONLY a direct
# push to `main` or `master` with no receipt, as defence in depth behind the
# org's `protect-main` ruleset (which already blocks direct pushes there by
# policy; this is a second, independent no). `scripts/merge-preflight.sh`
# remains the actual enforcement point for everything that reaches `main`
# through a PR merge, which is the overwhelming majority of pushes.
#
# `scripts/gate-receipt.sh` is what writes a receipt, as the last line of
# `make test` / `make test-full` (SH-394) — or `make test-changed` (SH-429),
# once that tier exists. Any receipt is reported by its tier so a push that
# skipped work never looks the same as one that didn't; `merge-preflight.sh`
# is what decides which tiers are strong enough to actually merge.
#
# Bypasses, both deliberate and both documented in CLAUDE.md:
#   SKIP_PREPUSH_TESTS=1   announced loudly here (a silent bypass is the same
#                          defect class in a friendlier costume)
#   git push --no-verify   git's own; this hook never runs at all

set -uo pipefail

if [ "${SKIP_PREPUSH_TESTS:-}" = "1" ]; then
    echo "pre-push: BYPASS — SKIP_PREPUSH_TESTS=1, shipping without a certified tree." >&2
    exit 0
fi

common_dir="$(cd "$(git rev-parse --git-common-dir)" && pwd)" || exit 1
receipts="$common_dir/storyhook/gate-receipts"

refused=0
unreceipted_commits=""

while read -r local_ref local_sha remote_ref remote_sha; do
    [ -n "${local_sha:-}" ] || continue

    # An all-zero local sha is a ref DELETION. It ships no content, so there is
    # nothing to certify — and resolving `^{tree}` on it would fail for entirely
    # the wrong reason.
    case "$local_sha" in
    *[!0]*) ;;
    *) continue ;;
    esac

    tree="$(git rev-parse --quiet --verify "${local_sha}^{tree}" </dev/null)" || {
        echo "pre-push: cannot resolve a tree for $local_ref ($local_sha)" >&2
        refused=1
        continue
    }

    # `remote_ref` — the ref being updated on the remote, e.g. `refs/heads/
    # main` — is what decides eligibility for a hard refusal; `main`/`master`
    # only. Every other branch still has to pass through `merge-preflight.sh`
    # to leave, which is where the real gate now lives (SH-429).
    branch="${remote_ref#refs/heads/}"
    is_protected_branch=0
    case "$branch" in
    main | master) is_protected_branch=1 ;;
    esac

    if [ ! -f "$receipts/$tree" ]; then
        if [ "$is_protected_branch" = 1 ]; then
            echo "pre-push: REFUSED — $local_ref (tree $tree) has no green receipt and $remote_ref is a protected branch." >&2
            echo "  Nothing certifies that this content passes. Run 'make test'; its" >&2
            echo "  last step writes the receipt. Bypass deliberately with" >&2
            echo "  SKIP_PREPUSH_TESTS=1 or --no-verify if this is a docs-only push." >&2
            refused=1
        else
            echo "pre-push: $local_ref (tree $tree) has no green receipt — reported, not refused (SH-429)." >&2
            echo "  This push is not what gates $remote_ref reaching main: since SH-396 a" >&2
            echo "  merge is a server-side operation this hook never sees, so" >&2
            echo "  scripts/merge-preflight.sh decides that. Run 'make test' before merging." >&2
        fi
        continue
    fi

    # Name the tier a passing receipt carries. A receipt written before
    # SH-394 has no `tier` line at all — treat that the same as `gate` rather
    # than failing to report it, since that is what it certified.
    tier="$(sed -n 's/^tier //p' "$receipts/$tree" 2>/dev/null | head -n1)"
    echo "pre-push: $local_ref (tree $tree) certified — tier ${tier:-gate}." >&2

    # Per-commit greenness is a rule this project states, and one this gate
    # deliberately does not enforce: a receipt per commit would mean a
    # nine-minute suite per commit, which is the pressure that produced SH-306
    # in the first place. So name what is being let through rather than either
    # blocking it or hiding it.
    if [ -z "${remote_sha:-}" ] || [ "${remote_sha//0/}" = "" ]; then
        range=(--max-count=50 "$local_sha" --not --remotes)
    else
        range=(--max-count=50 "${remote_sha}..${local_sha}")
    fi
    while read -r sha subject; do
        [ -n "${sha:-}" ] || continue
        commit_tree="$(git rev-parse --quiet --verify "${sha}^{tree}" </dev/null)" || continue
        [ -f "$receipts/$commit_tree" ] && continue
        unreceipted_commits="$unreceipted_commits  ${sha:0:9} ${subject:-}
"
    done < <(git log --format='%H %s' "${range[@]}" </dev/null 2>/dev/null || true)
done

if [ -n "$unreceipted_commits" ]; then
    echo "pre-push: these pushed commits carry no receipt of their own — the tip" >&2
    echo "  is certified, they are not, so a bisect can land on one nothing ran:" >&2
    printf '%s' "$unreceipted_commits" >&2
fi

exit "$refused"
