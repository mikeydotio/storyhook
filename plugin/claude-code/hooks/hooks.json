{
  "hooks": [
    {
      "event": "SessionStart",
      "type": "command",
      "command": "bash \"${PLUGIN_DIR}/hooks/session-start.sh\"",
      "timeout": 5000
    },
    {
      "event": "PostToolUse",
      "matcher": { "tool_name": "Bash" },
      "type": "command",
      "command": "bash \"${PLUGIN_DIR}/hooks/post-git.sh\"",
      "timeout": 10000
    },
    {
      "event": "Stop",
      "type": "command",
      "command": "bash \"${PLUGIN_DIR}/hooks/stop-handoff.sh\"",
      "timeout": 15000
    }
  ]
}
