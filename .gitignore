/target
# A second, separate target dir for coverage-instrumented builds
# (scripts/coverage-map.sh, SH-429) -- `-C instrument-coverage` changes every
# crate's build fingerprint, so sharing /target with ordinary `make test`
# builds would mean every switch between the two rebuilds from scratch.
/target-coverage
.DS_Store
.playwright-mcp/

.worktrees

# issue per-issue git worktrees (ephemeral — never commit)
.claude/worktrees/

# SessionStart-hook dispatch-readiness sentinel (SH-231). Written on every
# Claude Code session start, in every worktree (including a dispatched one's
# own checkout of this file) — a per-machine runtime artifact, never data.
.claude/dispatch-sentinel.json

# Project verifier journals and legacy local runtime state are not source.
/.storyhook/

# insta's pending-snapshot scratch files. `make test` pins INSTA_UPDATE=no so
# the gate never writes these, but a bare `cargo test` still does, and a
# committed .snap.new is an un-reviewed contract change waiting to be accepted.
*.snap.new

# Plugin state — ephemeral, per-machine, never committed
.freshen/
.council/

# e2e/'s Node toolchain and Playwright's own run artifacts — reinstalled by
# `make e2e-install`, regenerated by every `make e2e` run.
/e2e/node_modules/
/e2e/test-results/
/e2e/playwright-report/

# rca plugin
.rca/

# story per-story git worktrees (ephemeral — never commit)
.codex/worktrees/

# Session notes remain local; stories hold durable work context.
/HANDOFF.md

# Build allocation lock and interrupted atomic-write residue.
/.build-number.lock
/.BUILD-*

# Python bytecode. The test runners set PYTHONDONTWRITEBYTECODE, but a bare
# `python3 scripts/…` does not, and cargo treats any untracked, unignored file
# in the package as a reason to rerun build.rs (SH-783).
__pycache__/
