#!/usr/bin/env bash
# SH-672 tripwire: delegate production CLI operations, but record and refuse
# any census consultation. Manual dispatch must not reach this branch.
set -euo pipefail

real="${STORY_REAL_BIN:?STORY_REAL_BIN must point at the real story binary}"

is_lane_budget_call() {
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --project) shift 2 ;;
      --*) shift ;;
      *) [ "$1" = lane-budget ]; return ;;
    esac
  done
  return 1
}

if is_lane_budget_call "$@"; then
  printf 'called\n' >>"${STORY_CENSUS_CALL_LOG:?census call log must be isolated}"
  printf '{"result":"error","message":"unknown command: lane-budget"}\n'
  exit 2
fi
exec "$real" "$@"
