#!/usr/bin/env bash
# Fake `story` CLI for test-dispatch-claim-conflict.sh. A true race (another
# process claiming the story a moment before story.sh's own claim lands) isn't
# reproducible black-box without genuine concurrency, so this wrapper
# simulates it deterministically: it proxies every invocation to the REAL
# story binary (STORY_REAL_BIN, set by the test) EXCEPT the one `claim <id>`
# transaction identified by STORY_CONFLICT_ID, including its dispatch intent
# comment, which it answers with a canned {"result":"conflict",...} response.
# Every other subcommand (show, list, new, etc.) passes through unchanged, so
# the fixture stays realistic everywhere except the one moment under test.
#
# SH-482 retargeted the intercepted call: cmd_dispatch's ID MODE claimed with
# `move <id> <active> --if-state <expected>` until it was collapsed onto the
# `story claim` verb. The simulated race is unchanged; only the call that
# performs it is renamed. STORY_CONFLICT_EXPECTED is gone with it: `story
# claim` carries no `--if-state`, because a claim's precondition is "not
# already claimed" rather than one named slug, and its conflict reports the
# pseudo-state `unclaimed` as `expected` (SH-476). There is no caller-supplied
# witness left for this fake to match on.
#
# Note what this fake CANNOT do wrong quietly: an intercept that stops
# matching lets the REAL claim through, dispatch succeeds, and the test's
# `.ok == false` assertion fails loudly. It cannot go vacuously green.
#
# STORY_CONFLICT_RIVAL=1 (SH-346) additionally performs the REAL winning claim
# before answering conflict, rather than leaving the story's actual state
# untouched — simulating a genuine rival landing in the window rather than
# just a canned refusal.
set -euo pipefail

real="${STORY_REAL_BIN:?STORY_REAL_BIN must point at the real story binary}"

# is_claim_call <argv...> — true for the ONE call this fake answers itself.
#
# Since SH-120 story.sh pins `--project <slug>` ahead of every verb, so the
# global flags are skipped before the positional match. Skipped rather than
# matched loosely: this fake must intercept exactly one call and proxy every
# other, and a substring match would start catching neighbours.
is_claim_call() {
  while [ "$#" -gt 0 ]; do
    case "$1" in
    --project) shift 2 || return 1 ;;
    --project=*) shift ;;
    *) break ;;
    esac
  done
  [ "${1:-}" = "claim" ] && [ "${2:-}" = "${STORY_CONFLICT_ID:-}" ]
}

if is_claim_call "$@"; then
  if [ -n "${STORY_CONFLICT_RIVAL:-}" ]; then
    # Actually perform the winning claim, so the story genuinely leaves the
    # ready pool -- the canned response below is still what THIS caller sees
    # (it lost), independent of what the real command actually returned.
    "$real" "$@" >/dev/null 2>&1 || true
  fi
  # `expected` is the pseudo-state `unclaimed`, which is what a real
  # `story claim` conflict reports: a claim's precondition is any state other
  # than the active one, so naming a single slug there would be a lie (SH-476).
  printf '{"result":"conflict","expected":"unclaimed","actual":"in-progress","error":"state conflict: expected `unclaimed`, was `in-progress`","exit_code":9}\n'
  exit 9
fi

exec "$real" "$@"
