#!/usr/bin/env bash
# Proxy for test-dispatch-missing-claim-state.sh. Storyhook's own invariant
# prevents a test from deleting the required `in-progress` state, so this fake
# answers exactly the otherwise-unconstructable claim with the error an older
# or skewed store can produce. Every other command reaches the real CLI except
# `state list`, whose controlled modes prove the diagnosis degrades rather than
# guesses when confirmation is unavailable.
#
# An intercept that stops matching cannot go quietly green here either: the
# real claim would succeed and every `.ok == false` assertion in the test would
# fail.
set -euo pipefail

real="${STORY_REAL_BIN:?STORY_REAL_BIN must point at the real story binary}"

is_state_list() {
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --project) shift 2 || return 1 ;;
      --project=*) shift ;;
      *) break ;;
    esac
  done
  [ "${1:-}" = state ] && [ "${2:-}" = list ]
}

# SH-482 retargeted this: cmd_dispatch's ID MODE claimed with
# `move <id> <active> --if-state <state>` until it was collapsed onto the
# `story claim` verb. The error answered below is unchanged, because what it
# models is unchanged — a store whose vocabulary lacks the state the claim
# resolves into, which SH-125's invariant makes otherwise unconstructable.
is_claim_call() {
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --actor | --project) shift 2 || return 1 ;;
      --actor=* | --project=*) shift ;;
      *) break ;;
    esac
  done
  [ "${1:-}" = claim ]
}

if [ -n "${STORY_CLAIM_STATE_MISSING:-}" ] && is_claim_call "$@"; then
  printf '{"result":"error","error":"state `in-progress` is not defined","exit_code":2}\n'
  exit 2
fi

if is_state_list "$@"; then
  # SH-481: log WHICH form was asked for, not merely that something was.
  # cmd_dispatch now has two readers of this command with opposite costs --
  # story_active_state's plain read resolves the claim target on EVERY
  # dispatch, while missing_claim_state_vocabulary's `--json` read is the
  # failure-only classifier SH-440 added. A log that cannot tell them apart
  # can no longer pin the classifier as failure-only.
  if [ -n "${STORY_STATE_LIST_LOG:-}" ]; then
    case " $* " in
      *' --json '*) printf 'state list --json\n' >>"$STORY_STATE_LIST_LOG" ;;
      *) printf 'state list\n' >>"$STORY_STATE_LIST_LOG" ;;
    esac
  fi
  case "${STORY_STATE_LIST_MODE:-real}" in
    missing)
      printf '{"result":"ok","message":"todo (OPEN) — 1 open\\nblocked (OPEN)\\ndone (CLOSED)"}\n'
      exit 0
      ;;
    fail)
      printf '{"result":"error","error":"state list unavailable"}\n'
      exit 1
      ;;
    empty)
      printf '{"result":"ok","message":""}\n'
      exit 0
      ;;
    whitespace)
      printf '{"result":"ok","message":"\\n   \\n"}\n'
      exit 0
      ;;
    substring)
      # SH-481: `in-progress` is absent, but another slug CONTAINS it. The
      # membership test became a caller-supplied slug when the claim target
      # did, so a substring match over the whole message would read this
      # vocabulary as defining `in-progress` and withhold the diagnosis.
      printf '{"result":"ok","message":"todo (OPEN) — 1 open\\nin-progress-review (OPEN)\\ndone (CLOSED)"}\n'
      exit 0
      ;;
  esac
fi

exec "$real" "$@"
